# Read with: node --env-file=.env dist-server/server/main.js
HOST=127.0.0.1
PORT=4174
PUBLIC_ORIGIN=http://127.0.0.1:4174
NEBULA_DATA_DIR=.data/server
# Public hosting: HOST=0.0.0.0, PUBLIC_ORIGIN=https://your-domain.example
# Put a TLS reverse proxy in front of this process; never use an ephemeral data volume.

# Optional overrides; defaults: .data/tools binaries if present, otherwise PATH.
# NEBULA_FFMPEG_PATH=/absolute/path/to/ffmpeg
# NEBULA_FFPROBE_PATH=/absolute/path/to/ffprobe
